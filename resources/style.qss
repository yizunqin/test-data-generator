QMainWindow {
    background-color: #f5f7fa;
    font-family: "Arial", sans-serif;
    font-size: 14px;
    color: #333;
}

QWidget {
    background-color: #f5f7fa;
}

QPushButton {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #0056b3;
}

QPushButton:pressed {
    background-color: #003d80;
}

QLineEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #ccc;
    padding: 6px;
    border-radius: 4px;
    font-size: 14px;
}

QLabel {
    color: #333;
    font-size: 16px;
}

QTextEdit {
    background-color: #ffffff;
    border: 1px solid #ccc;
    padding: 6px;
    border-radius: 4px;
    font-size: 14px;
    color: #333;
}

QStatusBar {
    background-color: #f0f0f0;
    color: #333;
    font-size: 12px;
}

QListView, QTreeView {
    background-color: #ffffff;
    border: 1px solid #ccc;
    padding: 6px;
    border-radius: 4px;
    font-size: 14px;
    color: #333;
}

QHeaderView::section {
    background-color: #007bff;
    color: white;
    padding: 4px;
    border: none;
}
